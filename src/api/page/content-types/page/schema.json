{
  "kind": "collectionType",
  "collectionName": "pages",
  "info": {
    "singularName": "page",
    "pluralName": "pages",
    "displayName": "page"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string"
    },
    "slug": {
      "type": "string",
      "required": true,
      "unique": false
    },
    "content": {
      "type": "dynamiczone",
      "components": [
        "blocks.markdown",
        "blocks.menu",
        "blocks.accordion",
        "blocks.popup",
        "blocks.standout",
        "blocks.quote-block",
        "blocks.partner-carousel",
        "blocks.interactive-tool"
      ]
    },
    "children": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::page.page",
      "mappedBy": "parent"
    },
    "parent": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::page.page",
      "inversedBy": "children"
    }
  }
}
