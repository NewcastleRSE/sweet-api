{
  "kind": "collectionType",
  "collectionName": "up_users",
  "info": {
    "name": "user",
    "description": "",
    "singularName": "user",
    "pluralName": "users",
    "displayName": "User"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "username": {
      "type": "string",
      "minLength": 3,
      "unique": true,
      "configurable": false,
      "required": true
    },
    "email": {
      "type": "email",
      "minLength": 6,
      "configurable": false,
      "required": true
    },
    "provider": {
      "type": "string",
      "configurable": false
    },
    "password": {
      "type": "password",
      "minLength": 6,
      "configurable": false,
      "private": true,
      "searchable": false
    },
    "resetPasswordToken": {
      "type": "string",
      "configurable": false,
      "private": true,
      "searchable": false
    },
    "confirmationToken": {
      "type": "string",
      "configurable": false,
      "private": true,
      "searchable": false
    },
    "confirmed": {
      "type": "boolean",
      "default": false,
      "configurable": false
    },
    "blocked": {
      "type": "boolean",
      "default": false,
      "configurable": false
    },
    "refresh_tokens": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "plugin::refresh-token.token",
      "mappedBy": "user",
      "private": true,
      "configurable": false
    },
    "role": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.role",
      "inversedBy": "users",
      "configurable": false
    },
    "init": {
      "type": "date"
    },
    "SweetID": {
      "type": "uid"
    },
    "contacts": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::contact.contact",
      "mappedBy": "user"
    },
    "diaries": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::diary.diary",
      "mappedBy": "users_permissions_user"
    },
    "goals": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::goal.goal",
      "mappedBy": "user"
    },
    "metas": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::meta.meta",
      "mappedBy": "user"
    },
    "profilers": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::profiler.profiler",
      "mappedBy": "user"
    },
    "reminders": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::reminder.reminder",
      "mappedBy": "user"
    },
    "favourites": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::favourite.favourite",
      "mappedBy": "user"
    },
    "notes": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::note.note",
      "mappedBy": "user"
    },
    "side_effects": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::side-effect.side-effect",
      "mappedBy": "user"
    },
    "plans": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::plan.plan",
      "mappedBy": "user"
    },
    "thoughts": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::thought.thought",
      "mappedBy": "user"
    },
    "tunnels": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::tunnel.tunnel",
      "mappedBy": "users"
    },
    "firstName": {
      "type": "string"
    },
    "lastName": {
      "type": "string"
    },
    "deactivated": {
      "type": "boolean"
    },
    "adherences": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::adherence.adherence",
      "mappedBy": "user"
    },
    "drugs": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::drug.drug",
      "mappedBy": "user"
    },
    "mobile": {
      "type": "string"
    },
    "contact_preference": {
      "type": "enumeration",
      "enum": [
        "sms",
        "email"
      ]
    },
    "audit_logs": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::audit-log.audit-log",
      "mappedBy": "user"
    }
  }
}
